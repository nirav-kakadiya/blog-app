# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# OpenAI API (for content generation)
OPENAI_API_KEY="sk-..."

# Google Gemini API (for image generation - fallback)
GEMINI_API_KEY="..."

# Google Cloud Vertex AI (for Imagen 3 image generation)
# Place google-credentials.json in project root
# Or set this environment variable:
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="blog-images"
R2_ACCOUNT_ID="..."
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Platform API Keys (optional - for auto-publishing)
MEDIUM_TOKEN=""
DEVTO_API_KEY=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
