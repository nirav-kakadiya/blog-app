generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BlogType {
  guide
  prompt
  comparison
  tips
  usecase
  api
  upcoming
  troubleshoot
  tools
  review
}

enum BlogStatus {
  draft
  review
  published
}

enum LinkType {
  internal
  external
}

enum Platform {
  medium
  devto
  linkedin
  wordpress
  ghost
  hashnode
  quora
  reddit
}

model Blog {
  id                String      @id @default(uuid())
  keyword           String
  blogType          BlogType
  title             String
  metaDescription   String?
  content           String      @db.Text
  canonicalUrl      String?
  focusKeyword      String?
  secondaryKeywords String[]
  schemaJsonLd      String?     @db.Text
  aeoScore          Int?
  searchScore       Int?
  status            BlogStatus  @default(draft)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id])

  images         Image[]
  links          Link[]
  publishRecords PublishRecord[]

  @@index([status])
  @@index([blogType])
  @@index([createdAt])
  @@index([brandProfileId])
}

model Image {
  id        String   @id @default(uuid())
  blogId    String
  prompt    String
  s3Url     String
  altText   String
  placement String
  createdAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model Link {
  id        String   @id @default(uuid())
  blogId    String
  anchor    String
  url       String
  type      LinkType
  nofollow  Boolean  @default(false)
  createdAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model BrandProfile {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  domain      String
  sitemapUrl  String?
  description  String?  @db.Text
  isDefault    Boolean  @default(false)
  genuineMode  Boolean  @default(true) // true = genuine-content-first, false = aggressive promotion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools BrandTool[]
  blogs Blog[]

  @@index([userId])
  @@index([isDefault])
}

model BrandTool {
  id             String   @id @default(uuid())
  brandProfileId String
  name           String
  path           String
  category       String
  keywords       String[]
  description    String?
  priority       Int      @default(5)
  isAutoDetected Boolean  @default(false)
  createdAt      DateTime @default(now())

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model PublishRecord {
  id           String    @id @default(uuid())
  blogId       String
  platform     Platform
  publishedUrl String?
  publishedAt  DateTime?
  status       String

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, platform])
  @@index([blogId])
}
